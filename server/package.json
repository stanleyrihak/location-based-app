{
  "name": "@shoot/server",
  "version": "0.1.0",
  "private": true,
  "description": "The Shoot backend: accounts, caf\u00e9s, orders, payments, live updates and push.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "reset": "rm -rf data",
    "types:check": "tsc --noEmit -p .",
    "check": "npm run types:check && npm test",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "@hono/node-ws": "^1.3.1",
    "hono": "^4.13.19"
  }
}
