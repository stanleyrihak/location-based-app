{
  "expo": {
    "name": "Shoot Seller",
    "slug": "shoot-seller",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "shootseller",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "bundleIdentifier": "com.stanleyr.shootseller"
    },
    "android": {
      "package": "com.stanleyr.shootseller",
      "adaptiveIcon": {
        "backgroundColor": "#D06224",
        "foregroundImage": "./assets/images/app-icon-foreground.png",
        "monochromeImage": "./assets/images/app-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D06224",
          "image": "./assets/images/splash-wordmark.png",
          "imageWidth": 230
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#D06224"
        }
      ],
      "expo-maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to show the customer where you are while you bring their order.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3946ea9c-8273-4bb8-83f8-6f23cd525871"
      }
    },
    "owner": "stanley_r"
  }
}
