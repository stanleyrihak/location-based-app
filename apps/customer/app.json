{
  "expo": {
    "name": "Shoot",
    "slug": "location-based-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "locationbasedapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "bundleIdentifier": "com.stanley-r.location-based-app"
    },
    "android": {
      "package": "com.stanleyr.shoot",
      "adaptiveIcon": {
        "backgroundColor": "#D06224",
        "foregroundImage": "./assets/images/app-icon-foreground.png",
        "monochromeImage": "./assets/images/app-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D06224",
          "image": "./assets/images/splash-wordmark.png",
          "imageWidth": 230
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to show cafés within delivery range and to deliver your order to the exact spot."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Used to take the photo that shows the café it’s you and where you are, and to scan the code at your spot.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-maps",
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": true,
          "disableSPM": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "stanley_r",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4052bedc-1262-4ad3-a387-e276686fd217"
      }
    }
  }
}
