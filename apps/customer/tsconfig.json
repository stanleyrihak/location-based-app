{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // @shoot/shared imports its own files with a .ts extension, which the server (Node) needs.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
